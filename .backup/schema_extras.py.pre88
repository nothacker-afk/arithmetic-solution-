"""Schema extensions for all phases after the initial SCHEMA.

`ensure_extras(conn)` is idempotent. It:
  1. Creates all extra tables (in dependency order)
  2. Adds late-arriving columns to base tables
  3. Creates the FTS5 wiki index last (requires wiki_pages to exist)
"""
from __future__ import annotations
from .logging_config import get_logger

log = get_logger("web.schema")


# =====================================================================
# Extra tables (all CREATE TABLE IF NOT EXISTS)
# Order matters only for FTS-backed tables (created after their content
# table), which is handled separately below.
# =====================================================================
