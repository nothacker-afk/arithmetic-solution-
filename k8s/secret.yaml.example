# Copy to secret.yaml and fill in real values.
# Generate with:  python -c 'import secrets; print(secrets.token_hex(32))'
apiVersion: v1
kind: Secret
metadata:
  name: arithmetic-secrets
  namespace: arithmetic
type: Opaque
stringData:
  SECRET_KEY: "REPLACE-ME-WITH-32-BYTES-HEX"
  JWT_SECRET: "REPLACE-ME-WITH-32-BYTES-HEX"
